# Copy to .env and fill in. Never commit .env.
# For local dev, livekit-server --dev uses LIVEKIT_URL=ws://localhost:7880, key "devkey", secret "secret".

# apps/api
API_PORT=
DATABASE_URL=

# LiveKit (transport only)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Providers (required from the phase that first uses them)
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
GROQ_API_KEY=
